# ---------------------------------------------------------
# Vehicle Search Service — Environment Configuration
# ---------------------------------------------------------
# Copy this to .env and fill in values.
# All settings have sensible defaults; only DATABASE_URL is
# required (inherited from model1-service/.env if not set).
# ---------------------------------------------------------

# --- LLM Provider (query parsing) -----------------------
# Options: "offline" (rule-based, no API key), "gemini", "openai"
LLM_PROVIDER=offline
# LLM_MODEL=gemini-2.0-flash        # only when LLM_PROVIDER != offline
# GEMINI_API_KEY=                     # only for gemini
# OPENAI_API_KEY=                     # only for openai

# --- Vision-Language Model (SigLIP 2) -------------------
# Set to a HuggingFace model ID or local path. Leave empty to disable.
# VL_MODEL_NAME=google/siglip2-base-patch16-224
# VL_DEVICE=cpu                      # "cpu" or "cuda"
VL_EMBEDDING_DIM=768

# --- Existing Re-ID Model -------------------------------
# Relative to AI Registry root; overridden via absolute path if needed.
# VEHICLE_REID_MODEL_PATH=           # defaults to vehicle-reid/models/vehicle_vit_clip_reid.onnx

# --- Search Tuning --------------------------------------
SEARCH_TOP_K=50
RERANK_TOP_K=10
DEFAULT_LOCATION_RADIUS_METERS=1500

# --- Scoring Weights (must sum to ~1.0 conceptually) ----
REID_WEIGHT=0.20
VL_WEIGHT=0.20
GEO_WEIGHT=0.20
COLOR_WEIGHT=0.15
MODEL_WEIGHT=0.25

# --- Database (falls back to model1-service/.env) --------
# DATABASE_URL=postgresql://...

# --- Server ----------------------------------------------
VEHICLE_SEARCH_PORT=8300
VEHICLE_SEARCH_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
